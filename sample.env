# Port the server listens on (default: 30001)
PORT=30001

# --- Authentication (required unless AUTH_DISABLED=true) ---
# Generate random values, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# API keys your applications send in the X-API-Key header when submitting messages.
# Comma-separated name:key pairs; the name is stored with each message. Keys must be 16+ characters.
INGEST_API_KEYS=myapp:change-me-to-a-long-random-key

# Dashboard sign-in (username defaults to "admin")
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Signs dashboard session cookies (32+ characters). Changing it signs everyone out.
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Optional bearer token for reading/deleting messages from scripts and E2E tests (16+ characters):
#   curl -H "Authorization: Bearer $ADMIN_TOKEN" http://localhost:30001/api/messages/latest?phone=...
# ADMIN_TOKEN=

# Dashboard session lifetime in hours (default: 12)
# SESSION_TTL_HOURS=12

# Local development only: turns off all authentication
# AUTH_DISABLED=true

# --- Operations ---
# Set when running behind a reverse proxy (number of proxy hops, e.g. 1) so client IPs and HTTPS are detected
# TRUST_PROXY=1

# Max messages per minute per client IP on POST /api/messages (default: 120)
# INGEST_RATE_LIMIT=120

# Delete messages older than this many days (default: 0 = keep forever)
# RETENTION_DAYS=30

# Directory for log files (default: ./logs)
# LOG_DIR=./logs

# Set to false to log to stdout only (no log files)
# LOG_TO_FILE=true

# --- Database ---
# This decides what db to use: postgres, mysql, sqlite
DB_TYPE=sqlite

# SQLite database file path (default: ./sms-db.sqlite)
# SQLITE_PATH=./sms-db.sqlite

# For Postgres
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=your_pg_user
# PG_PASSWORD=your_pg_password
# PG_DATABASE=your_pg_db

# For MySQL
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=your_mysql_user
# MYSQL_PASSWORD=your_mysql_password
# MYSQL_DATABASE=your_mysql_db
